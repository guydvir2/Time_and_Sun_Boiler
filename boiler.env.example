# Secrets for BoilerMind. Copy to boiler.env on the server, fill in, then:  chmod 600 boiler.env
# Never commit boiler.env (it is git-ignored). The app never writes secrets anywhere.
#
# Docker:   docker run --env-file /path/to/boiler.env ...
# systemd:  EnvironmentFile=/path/to/boiler.env   (in the service's [Service] section)
#
# Leave a line out if you do not use it.
DASHBOARD_PASSWORD=choose-a-long-password
MQTT_PASSWORD=
HA_TOKEN=
# One-click "Update now" button: updater/install.sh creates UPDATER_TOKEN here by itself.
UPDATER_TOKEN=
